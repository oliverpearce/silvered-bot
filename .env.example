# Copy this to a file named .env and fill it in (never share it!)
DISCORD_TOKEN=paste-your-bot-token-here
CLIENT_ID=your-application-id
# Optional: your server's ID for instant command updates. Leave blank for all servers.
GUILD_ID=

# Web dashboard
#   local  (default) only reachable from this computer, at http://localhost:DASHBOARD_PORT
#   public reachable from anywhere at http://<server-address>:<port>/dashboard/ (use this on Wispbyte)
#   off    no dashboard
# DASHBOARD=public
# Your dashboard password. Required for public mode: make it long and random (16+ characters),
# and don't reuse a real password. Locally you can leave it blank to get a new one each start.
DASHBOARD_KEY=
# Optional: the dashboard's address, so /dashboard can post the link. On Wispbyte it's on the Network tab.
# DASHBOARD_URL=http://123.45.67.89:25565/dashboard/
# DASHBOARD_PORT=3001

# Port for the status page (and the dashboard in public mode). Wispbyte sets SERVER_PORT for you.
# PORT=3000
