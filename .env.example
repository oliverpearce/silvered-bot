# Copy this to a file named .env and fill it in (never share it!)
DISCORD_TOKEN=paste-your-bot-token-here
CLIENT_ID=your-application-id
# Optional: your server's ID for instant command updates. Leave blank for all servers.
GUILD_ID=

# Web dashboard
#   local  (default) only reachable from this computer, at http://localhost:DASHBOARD_PORT
#   public reachable at DASHBOARD_URL/dashboard/ with Discord login (use this on Google Cloud)
#   off    no dashboard
# DASHBOARD=public
# Public mode: the OAuth2 client secret from the Discord Developer Portal, and your HTTPS address.
DISCORD_CLIENT_SECRET=
# DASHBOARD_URL=https://bot.example.com
# Local mode only. Leave blank to get a new key each start.
DASHBOARD_KEY=
# DASHBOARD_PORT=3001

# Port for the status page (and the dashboard in public mode).
# PORT=3000
