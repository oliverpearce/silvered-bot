# Copy this to a file named .env and fill it in (never share it!)
DISCORD_TOKEN=paste-your-bot-token-here
CLIENT_ID=your-application-id
# Optional: your server's ID for instant command updates. Leave blank for all servers.
GUILD_ID=

# Web dashboard (only reachable from this computer)
# DASHBOARD_PORT=3001
# Optional: a fixed access key (long and random). Leave blank to get a new one each start.
DASHBOARD_KEY=
# Set to off to disable the dashboard (e.g. on Wispbyte)
# DASHBOARD=off
